{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FraudShield AI — Chat API Contract",
  "description": "Source-of-truth request/response shapes for POST /api/v1/submissions/{id}/chat. Owner: Member B. Frontend (Member D) ChatPanel codes against this.",
  "version": "1.0.0",
  "endpoints": {
    "POST /api/v1/submissions/{id}/chat": {
      "auth": "bearer",
      "description": "Ask a natural-language question about the sample. Answered against sanitized findings + retrieved TTP context only — never raw untrusted strings.",
      "request": { "$ref": "#/definitions/ChatRequest" },
      "response": { "status": 200, "body": { "$ref": "#/definitions/ChatResponse" } },
      "errors": [
        { "status": 404, "code": "not_found", "message": "No findings for this submission yet" },
        { "status": 429, "code": "rate_limited", "message": "Chat rate limit exceeded (Claude tier cap)" }
      ]
    }
  },
  "definitions": {
    "ChatRequest": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "ChatResponse": {
      "type": "object",
      "required": ["reply", "sources", "cached"],
      "properties": {
        "reply": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/ChatSource" }
        },
        "cached": { "type": "boolean", "description": "True if served from the response cache." }
      }
    },
    "ChatSource": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["static_findings", "ttp"] },
        "id": { "type": "string", "description": "TTP id when type=ttp" },
        "name": { "type": "string" },
        "package_name": { "type": ["string", "null"] }
      }
    }
  }
}
