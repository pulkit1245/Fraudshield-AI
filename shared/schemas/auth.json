{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FraudShield AI — Auth API Contract",
  "description": "Source-of-truth request/response shapes for /api/v1/auth. Owner: Member A. Frontend (Member D) codes against this.",
  "version": "1.0.0",
  "endpoints": {
    "POST /api/v1/auth/register": {
      "auth": "none",
      "request": { "$ref": "#/definitions/RegisterRequest" },
      "response": { "status": 201, "body": { "$ref": "#/definitions/RegisterResponse" } },
      "errors": [
        { "status": 409, "code": "conflict", "message": "Email already registered" },
        { "status": 422, "code": "validation_error", "message": "Invalid input" }
      ]
    },
    "POST /api/v1/auth/login": {
      "auth": "none",
      "request": { "$ref": "#/definitions/LoginRequest" },
      "response": { "status": 200, "body": { "$ref": "#/definitions/TokenPairResponse" } },
      "errors": [
        { "status": 401, "code": "unauthorized", "message": "Invalid credentials" },
        { "status": 429, "code": "rate_limited", "message": "Too many requests" }
      ]
    },
    "POST /api/v1/auth/refresh": {
      "auth": "none",
      "request": { "$ref": "#/definitions/RefreshRequest" },
      "response": { "status": 200, "body": { "$ref": "#/definitions/AccessTokenResponse" } },
      "errors": [
        { "status": 401, "code": "unauthorized", "message": "Expired/invalid refresh token" }
      ]
    },
    "GET /api/v1/auth/me": {
      "auth": "bearer",
      "response": { "status": 200, "body": { "$ref": "#/definitions/UserProfile" } },
      "errors": [
        { "status": 401, "code": "unauthorized", "message": "Unauthenticated" }
      ]
    }
  },
  "definitions": {
    "RegisterRequest": {
      "type": "object",
      "required": ["email", "password", "org_name"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string", "minLength": 10, "maxLength": 128 },
        "org_name": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "RegisterResponse": {
      "type": "object",
      "required": ["id", "email", "role"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["analyst", "lead", "admin"] }
      }
    },
    "LoginRequest": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RefreshRequest": {
      "type": "object",
      "required": ["refresh_token"],
      "properties": { "refresh_token": { "type": "string" } },
      "additionalProperties": false
    },
    "TokenPairResponse": {
      "type": "object",
      "required": ["access_token", "refresh_token", "token_type", "expires_in"],
      "properties": {
        "access_token": { "type": "string" },
        "refresh_token": { "type": "string" },
        "token_type": { "type": "string", "enum": ["bearer"] },
        "expires_in": { "type": "integer", "description": "Access token lifetime, seconds" }
      }
    },
    "AccessTokenResponse": {
      "type": "object",
      "required": ["access_token", "token_type", "expires_in"],
      "properties": {
        "access_token": { "type": "string" },
        "token_type": { "type": "string", "enum": ["bearer"] },
        "expires_in": { "type": "integer" }
      }
    },
    "UserProfile": {
      "type": "object",
      "required": ["id", "email", "role", "org_name", "created_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["analyst", "lead", "admin"] },
        "org_name": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
