# ─── FraudShield AI — Local Dynamic Worker Environment ─────────────────────
# Copy this file to .env.local-dynamic (same infra/ directory)
# Fill in values from your Render, CloudAMQP, and Backblaze dashboards.
# This file is git-ignored — NEVER commit it.

# ── Database (Render Managed PostgreSQL) ───────────────────────────────────
# Get this from: Render Dashboard → fraudshield-db → Connection → External URL
DATABASE_URL=postgresql+psycopg2://fraudshield:<password>@<host>.oregon-postgres.render.com/fraudshield

# ── Redis (Render Managed Redis) ───────────────────────────────────────────
# Get this from: Render Dashboard → fraudshield-redis → Connection → External URL
REDIS_URL=rediss://:<password>@<host>.render.com:6379

# ── RabbitMQ (CloudAMQP) ───────────────────────────────────────────────────
# Get this from: cloudamqp.com → Your Instance → AMQP URL
RABBITMQ_URL=amqps://user:password@mole.rmq.cloudamqp.com/vhost

# ── JWT (must match what's set in Render backend service) ──────────────────
# Copy this from: Render Dashboard → fraudshield-backend → Environment → JWT_SECRET
JWT_SECRET=your-render-jwt-secret-here

# ── Object Storage (Backblaze B2) ──────────────────────────────────────────
# Get from: Backblaze B2 → Buckets → App Keys
STORAGE_BUCKET=fraudshield-apks
STORAGE_KEY=your-b2-key-id
STORAGE_SECRET=your-b2-application-key
# Format: https://s3.<region>.backblazeb2.com
STORAGE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
STORAGE_REGION=us-west-004

# ── LLM Keys ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...

# ── Dynamic Analysis Settings ──────────────────────────────────────────────
SANDBOX_MODE=live
EXPLORE_APK=true
SANDBOX_RUN_SECONDS=30

# ── Misc ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=https://fraudshield-frontend.onrender.com
