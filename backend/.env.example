# ─── FraudShield AI · Backend env (Member A slice) ─────────────────────
# Copy to `.env` and fill in. Never commit the real .env.
# The canonical, all-services list is owned by Member D at repo-root .env.example.

# App
ENVIRONMENT=development
DEBUG=true

# Database (Member A)
DATABASE_URL=postgresql+psycopg2://fraudshield:fraudshield@localhost:5432/fraudshield

# Auth / JWT (Member A)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cache / broker (Member C)
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Object storage — S3 compatible (Member A)
STORAGE_BUCKET=fraudshield-apks
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-005

# External services
CLAUDE_API_KEY=
VIRUSTOTAL_API_KEY=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173
