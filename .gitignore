# ─── FraudShield AI · .gitignore (Member D) ────────────────────────────
# Secrets
.env
.env.*
!.env.example
!infra/.env.local-dynamic.example
backend/adb_keys/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Object-storage / sandbox scratch + raw samples (never commit APKs)
/tmp/fraudshield-storage/
*.apk
sandbox_logs/

# Local SQLite scratch DB (Postgres is the real database)
backend/fraudshield.db
*.sqlite3

# CICMalDroid2020 research dataset — ~26MB of public CSVs.
# Re-downloadable from https://www.unb.ca/cic/datasets/maldroid-2020.html
# train_real.py expects them at backend/data/cicmaldroid/.
csv_folder/
backend/data/cicmaldroid/
feature_vectors_*.csv
feature_vectors_static.csv
syscall_unique.csv

# AI coding-assistant workspaces (local tooling, not project source)
.claude/
.opencode/

# OS / editor
.DS_Store
.idea/
.vscode/

# NOTE: backend/app/ml/classifier/model.pkl IS committed on purpose
# (485 KB trained artifact the pipeline loads at runtime).
