# ─── FraudShield AI · all-services env (repo root) ─────────────────────
# Copy to `.env` (git-ignored). docker-compose and the backend read this file.

# ── App ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database (Member A) ────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://fraudshield:fraudshield@postgres:5432/fraudshield

# ── Auth / JWT (Member A) ──────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Object storage — S3 compatible (Member A) ──────────────────────────
STORAGE_BUCKET=fraudshield-apks
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-005

# ── Cache / broker (Member C) ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# ── External services ──────────────────────────────────────────────────
# Primary LLM (Groq). Blank = offline fallback responses.
GROQ_API_KEY=
GEMINI_API_KEY=
# CLAUDE_API_KEY: Member B — LLM orchestration
CLAUDE_API_KEY=
# VIRUSTOTAL_API_KEY: Member C — hash cross-check
VIRUSTOTAL_API_KEY=

# ── Dynamic sandbox (Member C) ─────────────────────────────────────────
# SANDBOX_MODE: simulate | live
SANDBOX_MODE=simulate

# ── CORS (Member A) ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]

# ── Frontend (Member D) ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Threat Intelligence ingestion (Member B) ───────────────────────────
# Free key from https://otx.alienvault.com — leave blank to skip the OTX source.
OTX_API_KEY=
MALWAREBAZAAR_ENABLED=true

# Authentication and Secrets
JWT_SECRET=super_secret_jwt_key
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield
POSTGRES_DB=fraudshield
DATABASE_URL=postgresql+psycopg2://fraudshield:fraudshield@postgres:5432/fraudshield
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
FLOWER_USER=admin
FLOWER_PASSWORD=admin
